{
  "name": "@amr/dsh-theme",
  "version": "1.0.1",
  "private": true,
  "description": "Aston Martin Formula One Team theme for DeepSeek Harness: British racing green, luminous lime, carbon, start lights, and the winged race plates.",
  "type": "module",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "icon.svg",
    "assets/wings.png",
    "assets/wordmark.png",
    "locale/*.json",
    "README.md"
  ],
  "license": "MIT",
  "author": "Sean Montecillo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmontecillo/dsh-aston-martin-f1-theme.git"
  },
  "homepage": "https://github.com/delmontecillo/dsh-aston-martin-f1-theme#readme",
  "bugs": {
    "url": "https://github.com/delmontecillo/dsh-aston-martin-f1-theme/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
